<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+: visibilidad de paquetes para lanzar Waze / OsmAnd / YT Music -->
    <queries>
        <package android:name="com.waze" />
        <package android:name="net.osmand.plus" />
        <package android:name="net.osmand" />
        <package android:name="com.google.android.apps.youtube.music" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waze" />
        </intent>
    </queries>

    <!-- Los permisos de Bluetooth/GPS se agregan en el paso de la capa bluetooth/ -->

    <application
        android:label="VERSYS TFT"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
